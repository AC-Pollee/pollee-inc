{
  "name": "Poll",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "The poll question"
    },
    "description": {
      "type": "string",
      "description": "Additional context for the poll"
    },
    "options": {
      "type": "array",
      "description": "Voting options",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "franchise_id": {
      "type": "string",
      "description": "Franchise that created this poll"
    },
    "poll_level": {
      "type": "string",
      "enum": [
        "local",
        "state",
        "federal"
      ],
      "default": "local",
      "description": "Level of poll scope"
    },
    "postcodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Postcodes eligible to vote (for local polls)"
    },
    "state": {
      "type": "string",
      "description": "State for state-level polls"
    },
    "assigned_infomarians": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Infomarian IDs assigned to moderate this poll"
    },
    "discussion_created_by": {
      "type": "string",
      "description": "Infomarian ID who created the issue discussion thread"
    },
    "discussion_status": {
      "type": "string",
      "enum": [
        "open",
        "archived"
      ],
      "default": "open",
      "description": "Discussion thread status - archived for future reference when vote completes"
    },
    "archived_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the discussion thread was archived"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Moderation status for new polls"
    },
    "moderated_by": {
      "type": "string",
      "description": "Email or ID of the moderator who reviewed the poll"
    },
    "moderation_reason": {
      "type": "string",
      "description": "Reason for rejection if poll is rejected"
    },
    "moderation_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the poll was moderated"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "reputation_awarded": {
      "type": "boolean",
      "default": false,
      "description": "Whether the +10 reputation bonus for poll approval has been awarded to the creator"
    },
    "budget_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the budget engine is attached to this proposal. Attached by default on new proposals; toggled by Infomarian or above."
    },
    "budget_status": {
      "type": "string",
      "enum": [
        "draft",
        "finalised"
      ],
      "default": "draft",
      "description": "Draft until every budget line has a figure entered by Infomarian or above, then finalised. Editing any line reverts to draft."
    },
    "budget_lines": {
      "type": "array",
      "default": [],
      "description": "Budget line items for this proposal. Each line needs a cost figure entered by Infomarian or above before the budget can finalise.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "What this line pays for"
          },
          "cost": {
            "type": "number",
            "description": "Budget figure in dollars, entered by Infomarian or above"
          },
          "ci": {
            "type": "number",
            "description": "Confidence interval as a +/- percentage, 0 to 100"
          },
          "entered_by_id": {
            "type": "string",
            "description": "User ID of the Infomarian who entered the figure"
          },
          "entered_by_name": {
            "type": "string",
            "description": "Name of the Infomarian who entered the figure"
          },
          "entered_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the figure was entered"
          }
        },
        "required": [
          "id",
          "label"
        ]
      }
    }
  },
  "required": [
    "title",
    "options",
    "franchise_id",
    "poll_level"
  ]
}