{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Conversation this message belongs to"
    },
    "sender_id": {
      "type": "string",
      "description": "User ID of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the sender"
    },
    "content": {
      "type": "string",
      "description": "Message text"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Conversation participants (denormalized for RLS read access)"
    }
  },
  "required": [
    "conversation_id",
    "sender_id",
    "content",
    "participants"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participants": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.participants": {
            "$in": [
              "{{user.id}}"
            ]
          }
        }
      ]
    },
    "update": {
      "data.sender_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}