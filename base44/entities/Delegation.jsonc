{
  "name": "Delegation",
  "type": "object",
  "properties": {
    "delegator_user_id": {
      "type": "string",
      "description": "User who is delegating their vote"
    },
    "delegator_full_name": {
      "type": "string",
      "description": "Full name of delegator"
    },
    "delegate_user_id": {
      "type": "string",
      "description": "User who will carry the delegation"
    },
    "delegate_full_name": {
      "type": "string",
      "description": "Full name of delegate"
    },
    "delegation_type": {
      "type": "string",
      "enum": [
        "open",
        "specific_poll"
      ],
      "description": "Open for all polls or specific poll only"
    },
    "poll_id": {
      "type": "string",
      "description": "Specific poll ID if delegation_type is specific_poll"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "revoked"
      ],
      "default": "pending",
      "description": "Delegation verification status"
    },
    "verified_date": {
      "type": "string",
      "format": "date-time",
      "description": "When delegation was verified"
    }
  },
  "required": [
    "delegator_user_id",
    "delegator_full_name",
    "delegate_user_id",
    "delegation_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.delegator_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.delegator_user_id": "{{user.id}}"
        },
        {
          "data.delegate_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.delegator_user_id": "{{user.id}}"
        },
        {
          "data.delegate_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.delegator_user_id": "{{user.id}}"
        },
        {
          "data.delegate_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}