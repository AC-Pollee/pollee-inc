{
  "name": "User",
  "type": "object",
  "properties": {
    "avatar_url": {
      "type": "string",
      "description": "URL of the user's uploaded avatar image (JPG or PNG, square, <= 2MB)"
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of the user's most recent presence heartbeat, used to count active sessions"
    },
    "last_name": {
      "type": "string",
      "description": "Last name of the user"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "infomarian_id": {
      "type": "string",
      "description": "Infomarian ID"
    },
    "franchise_id": {
      "type": "string",
      "description": "Constituency (franchise) the user has chosen to belong to"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone number"
    },
    "bsb": {
      "type": "string",
      "description": "Bank BSB number"
    },
    "account_number": {
      "type": "string",
      "description": "Bank account number"
    },
    "account_name": {
      "type": "string",
      "description": "Bank account name"
    },
    "account_validated": {
      "type": "boolean",
      "default": false,
      "description": "Whether the bank account has been validated"
    },
    "validation_initiated": {
      "type": "boolean",
      "default": false,
      "description": "Whether validation deposit has been made"
    },
    "validation_deposit_amount": {
      "type": "number",
      "description": "Random validation amount sent to user"
    },
    "voter_id": {
      "type": "string",
      "description": "Unique voter ID assigned after validation"
    },
    "user_role": {
      "type": "string",
      "enum": [
        "voter",
        "infomarian",
        "franchise_manager",
        "master_franchiser"
      ],
      "default": "voter",
      "description": "User role in the system"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "fr",
        "de",
        "es",
        "nl"
      ],
      "default": "en",
      "description": "User's preferred UI language"
    },
    "confirmation_code": {
      "type": "string",
      "description": "Random 6-digit code emailed to the member for initial account confirmation"
    },
    "confirmation_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the member has confirmed their account via the emailed code"
    },
    "strikes": {
      "type": "array",
      "default": [],
      "description": "Conduct violation strikes",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Date strike was issued"
          },
          "infomarian_id": {
            "type": "string",
            "description": "Infomarian who issued the strike"
          },
          "infomarian_name": {
            "type": "string",
            "description": "Name of the Infomarian"
          },
          "reason": {
            "type": "string",
            "description": "Reason for the strike"
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "moderate",
              "severe"
            ],
            "description": "Severity of the violation"
          },
          "comment_id": {
            "type": "string",
            "description": "Related comment ID if applicable"
          }
        }
      }
    },
    "commenting_restricted": {
      "type": "boolean",
      "default": false,
      "description": "Whether commenting rights are restricted"
    },
    "suspension_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date when current suspension ends"
    },
    "permanently_banned": {
      "type": "boolean",
      "default": false,
      "description": "Permanently banned from commenting (4+ strikes)"
    },
    "reputation_score": {
      "type": "number",
      "default": 100,
      "description": "User reputation score (0-1000)"
    },
    "reputation_breakdown": {
      "type": "object",
      "default": {
        "verified_votes": 0,
        "approved_comments": 0,
        "successful_delegations": 0,
        "received_delegations": 0,
        "strikes_minor": 0,
        "strikes_moderate": 0,
        "strikes_severe": 0,
        "flagged_content": 0,
        "claps_received": 0,
        "approved_polls": 0
      },
      "description": "Breakdown of reputation components"
    },
    "reputation_level": {
      "type": "string",
      "enum": [
        "newcomer",
        "member",
        "contributor",
        "trusted",
        "champion"
      ],
      "default": "newcomer",
      "description": "Reputation tier"
    },
    "change_history": {
      "type": "array",
      "default": [],
      "description": "Audit log of changes made to this user's record after creation",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "When the change was made"
          },
          "changed_by_id": {
            "type": "string",
            "description": "User ID of the moderator who made the change"
          },
          "changed_by_name": {
            "type": "string",
            "description": "Name of the moderator who made the change"
          },
          "changed_by_role": {
            "type": "string",
            "description": "Role of the moderator (admin, infomarian, master_franchiser, franchise_manager)"
          },
          "field": {
            "type": "string",
            "description": "Name of the field that was changed"
          },
          "old_value": {
            "description": "Previous value of the field"
          },
          "new_value": {
            "description": "New value of the field"
          },
          "reason": {
            "type": "string",
            "description": "Optional note explaining why the change was made"
          }
        }
      }
    }
  },
  "required": [
    "last_name",
    "date_of_birth",
    "infomarian_id",
    "phone_number",
    "bsb",
    "account_number",
    "account_name",
    "validation_deposit_amount",
    "voter_id"
  ]
}