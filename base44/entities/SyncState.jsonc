{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "page_token": {
      "type": "string",
      "description": "Google Drive Changes API page token for incremental sync"
    },
    "label": {
      "type": "string",
      "description": "Identifier for this sync state",
      "default": "googledrive"
    }
  },
  "required": [
    "page_token"
  ]
}